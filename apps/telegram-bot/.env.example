# 使用前将 example.invalid 地址替换为您自己的 HTTPS 域名。
# Telegram BotFather token（勿提交真实 token；复制本文件为 .env 后填写）
BOT_TOKEN=

# 本地访问 api.telegram.org 的 HTTP 代理（Clash 混合端口常见 7890/7897）
# 未填时也会读 HTTPS_PROXY / HTTP_PROXY
TELEGRAM_PROXY_URL=

# polling (local) | webhook (production)
BOT_MODE=polling

WEBHOOK_DOMAIN=https://bot.example.com
# 可留空自动派生；显式设置时使用 1–256 位英文字母、数字、下划线或连字符
WEBHOOK_SECRET=
PORT=8080

WEB_APP_URL=https://your-app.example.invalid
MARKETING_URL=https://your-site.example.invalid
TG_CHANNEL_URL=
TG_GROUP_URL=
API_BASE_URL=http://127.0.0.1:8888/api/v1
STATIC_BASE_URL=

BOT_API_KEY=
DEV_CHAT_JWT=

CHAT_NUDGE_AFTER_TURNS=3
BOT_MAX_TURNS_PER_DAY=12
CHAT_REPLY_MAX_CHARS=3500

# Ops: comma-separated Telegram user IDs for /drop /aff /stats
OPS_TELEGRAM_IDS=

# Optional override; otherwise filled from getMe() at boot
BOT_USERNAME=

# Optional voice preview on agent cards (default off)
TTS_PREVIEW_ENABLED=false
TTS_PREVIEW_VOICE_ID=

# Ammer Pay · Telegram Payments provider_token (LIVE). Leave empty to disable /vip invoices.
PAYMENT_PROVIDER_TOKEN=

FEATURED_ROLE_IDS=
# 独立客服 Telegram Bot（与主 BOT_TOKEN 分开）
SUPPORT_BOT_TOKEN=
SUPPORT_BOT_USERNAME=

# 可选：角色卡定制 Bot
CUSTOM_AGENT_BOT_TOKEN=
CUSTOM_AGENT_BOT_USERNAME=

# 客服 LLM：可用 SUPPORT_LLM_API_KEY，或与后端相同的 OPENROUTER_API_KEY
SUPPORT_LLM_API_KEY=
OPENROUTER_API_KEY=
SUPPORT_LLM_BASE_URL=https://openrouter.ai/api/v1
SUPPORT_LLM_MODEL=deepseek/deepseek-v4-flash
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
EVENTS_DIR=.events
UTM_CAMPAIGN=bot_mvp

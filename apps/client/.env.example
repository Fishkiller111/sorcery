# 所有 EXPO_PUBLIC_ 变量会进入客户端包，绝不能放密钥。
# 手机真机请改成手机可访问的本机局域网 IP；Android 模拟器需使用对应宿主地址。
EXPO_PUBLIC_API_HOST=http://localhost:8888
EXPO_PUBLIC_APP_SITE_URL=http://localhost:8081
EXPO_PUBLIC_MARKETING_SITE_URL=http://localhost:8081
# 未设置时使用占位图；请提供自有且拥有分发权的素材服务。
EXPO_PUBLIC_APP_STATIC_BASE=
EXPO_PUBLIC_GA_MEASUREMENT_ID=
EXPO_PUBLIC_YANDEX_METRIKA_ID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_APPLE_CLIENT_ID=
EXPO_PUBLIC_TELEGRAM_BOT_ID=
EXPO_PUBLIC_TELEGRAM_BOT_USERNAME=
EXPO_PUBLIC_TURNSTILE_SITE_KEY=

# 可选社交与客服入口：留空不展示；站点链接要求 HTTPS。
EXPO_PUBLIC_SOCIAL_X_URL=
EXPO_PUBLIC_SOCIAL_TELEGRAM_URL=
EXPO_PUBLIC_SUPPORT_BOT_USERNAME=
# 隐私与服务条款：发布时填入自己的 HTTPS 页面。
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=

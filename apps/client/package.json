{
  "name": "soulthreadscene",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "bash scripts/expo-dev.sh start ",
    "android": "bash scripts/expo-dev.sh start --android ",
    "ios": "bash scripts/expo-dev.sh start --ios ",
    "ios:ipad": "bash scripts/expo-ios-ipad.sh ",
    "web": "bash scripts/expo-dev.sh start --web ",
    "ios:native": "bash scripts/expo-dev.sh run:ios ",
    "ios:native:ipad": "bash scripts/expo-dev.sh run:ios --device \"iPad Pro\" ",
    "android:native": "bash scripts/expo-dev.sh run:android ",
    "build:web": "tsx scripts/generate-web-seo.ts && expo export --platform web && tsx scripts/prepare-spa-fallback.ts",
    "build:eas:android": "bash scripts/eas-cloud-build.sh android",
    "build:eas:ios": "bash scripts/eas-cloud-build.sh ios",
    "build:eas:all": "bash scripts/eas-cloud-build.sh all",
    "build:eas:android:prod": "bash scripts/eas-cloud-build.sh android production",
    "build:eas:android:aab": "bash scripts/eas-cloud-build.sh android production-aab",
    "build:eas:ios:prod": "bash scripts/eas-cloud-build.sh ios production",
    "build:eas:ios:dev": "bash scripts/eas-cloud-build.sh ios development",
    "submit:eas:ios": "bash scripts/eas-submit.sh ios --latest",
    "submit:eas:android": "bash scripts/eas-submit.sh android --latest",
    "extract-ui": "python3 scripts/extract-ui-assets.py",
    "extract-profile": "python3 scripts/extract-profile-assets.py",
    "extract-setting": "python3 scripts/extract-setting-assets.py",
    "extract-pc-shell": "python3 scripts/extract-pc-shell-assets.py",
    "typecheck": "tsc --noEmit --pretty false",
    "test:config": "node scripts/test-open-source-config.cjs",
    "test:soft-upsell": "node --experimental-strip-types --test src/utils/__tests__/freeChatSoftUpsell.test.ts"
  },
  "dependencies": {
    "@elevenlabs/client": "^1.15.2",
    "@expo-google-fonts/bebas-neue": "^0.4.1",
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/oswald": "^0.4.2",
    "@expo-google-fonts/work-sans": "^0.4.2",
    "@expo/metro-runtime": "~57.0.13",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "dagre": "^0.8.5",
    "expo": "~57.0.16",
    "expo-apple-authentication": "~57.0.1",
    "expo-asset": "~57.0.14",
    "expo-audio": "~57.0.4",
    "expo-build-properties": "~57.0.14",
    "expo-constants": "~57.0.14",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-iap": "^4.5.0",
    "expo-image": "~57.0.3",
    "expo-image-manipulator": "~57.0.13",
    "expo-image-picker": "~57.0.13",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-localization": "~57.0.1",
    "expo-media-library": "~57.0.4",
    "expo-modules-core": "~57.0.13",
    "expo-router": "~57.0.16",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.2",
    "livekit-client": "^2.21.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-easy-crop": "^6.1.0",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "use-sync-external-store": "^1.6.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/dagre": "^0.7.54",
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3",
    "tsx": "4.23.15"
  },
  "private": true,
  "license": "Apache-2.0"
}
